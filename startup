# RUN THIS

sudo docker network connect interact_go_backend-network interact-ml 

For DEV setup, USE: docker-compose -f dev.docker-compose.yml

to flush DB:

-- Drop all tables and related objects
DO $$ 
DECLARE
    r RECORD;
BEGIN
    -- Disable all triggers (if you want to ignore constraints)
    EXECUTE 'SET session_replication_role = replica';

    -- Drop all tables
    FOR r IN (SELECT tablename FROM pg_tables WHERE schemaname = 'public') 
    LOOP
        EXECUTE 'DROP TABLE IF EXISTS public.' || r.tablename || ' CASCADE';
    END LOOP;

    -- Enable all triggers (reset back to default)
    EXECUTE 'SET session_replication_role = DEFAULT';
END $$;

crontab -e
0 0 */3 * * sudo docker exec interact-ml python3 trainer.py